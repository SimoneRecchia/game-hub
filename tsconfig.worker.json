{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [
      "@cloudflare/workers-types"
    ],
    "skipLibCheck": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo"
  },
  "include": [
    "functions",
    "server",
    "shared"
  ],
  // I test girano in Node con Vitest, non nel Worker: quelli di shared/ li
  // verifica tsconfig.app.json, quelli del server tsconfig.server-test.json.
  // Qui leggerebbero `node:fs` con i tipi del Worker, che non li conoscono.
  "exclude": [
    "shared/__tests__",
    "server/__tests__"
  ]
}
