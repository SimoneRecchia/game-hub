{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [
      "@cloudflare/workers-types"
    ],
    "skipLibCheck": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo"
  },
  "include": [
    "functions",
    "server",
    "shared"
  ],
  // I test di shared/ girano in Node con Vitest, non nel Worker: li verifica
  // tsconfig.app.json, che ha i tipi di Node. Qui leggerebbero `node:fs` con i
  // tipi del Worker, che non li conoscono.
  "exclude": [
    "shared/__tests__"
  ]
}
