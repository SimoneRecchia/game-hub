# Header HTTP per Cloudflare Pages
# https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=()
  Cross-Origin-Opener-Policy: same-origin

# Il bundle ha l'hash nel nome: si può cachare per sempre.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# L'entry point deve poter cambiare a ogni deploy.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# Il dizionario dello Scarabeo: l'indirizzo porta l'impronta (?v=), che cambia a ogni versione.
# I due file e non /scarabeo/*: sotto /scarabeo/ ci sono anche le pagine dell'app, che le Pages
# servono con index.html, e la regola le teneva in cache per un anno.
/scarabeo/dizionario.dawg
  Cache-Control: public, max-age=31536000, immutable
/scarabeo/dizionario.dawg.gz
  Cache-Control: public, max-age=31536000, immutable

# I dati delle materie del quiz: anche qui l'impronta sta nell'indirizzo. Sotto /dati/ non ci sono pagine.
/dati/*
  Cache-Control: public, max-age=31536000, immutable

/manifest.webmanifest
  Cache-Control: public, max-age=3600

/icon.svg
  Cache-Control: public, max-age=604800
/icon-192.png
  Cache-Control: public, max-age=604800
/icon-512.png
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800

# Punteggi e sessioni: mai in cache.
/api/*
  Cache-Control: no-store
