{
  // I test del server: il codice del Worker, ma eseguito in Node da Vitest.
  // Servono i tipi di tutti e due — D1 da una parte, `node:sqlite` e `node:fs`
  // del banco di prova dall'altra — e per questo hanno un progetto loro,
  // separato da tsconfig.worker.json, che resta con i soli tipi del Worker.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types", "node"],
    "skipLibCheck": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.server-test.tsbuildinfo"
  },
  "include": ["server/__tests__"]
}
