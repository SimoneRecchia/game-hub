{
  "name": "game-hub",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Hub di giochi da browser con nickname, classifiche e parola giornaliera",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-config.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "words:build": "node scripts/build-wordlist.mjs",
    "cruciverba:dati": "node scripts/build-cruciverba.mjs",
    "cruciverba:locale": "node scripts/genera-cruciverba.mjs --local && node scripts/genera-cruciverba.mjs --local --liberi 10",
    "scarabeo:locale": "vite-node scripts/genera-computer-scarabeo.ts -- --local",
    "quiz:locale": "vite-node scripts/genera-quiz.ts -- --local",
    "quiz:cultura": "vite-node scripts/genera-cultura.ts && vite-node scripts/versioni-cultura.ts",
    "quiz:oggi": "vite-node scripts/genera-oggi.ts && vite-node scripts/versioni-cultura.ts",
    "sudoku:locale": "vite-node scripts/genera-sudoku.ts -- --local",
    "anagrammi:locale": "vite-node scripts/genera-anagrammi.ts -- --local",
    "anagrammi:build": "node scripts/build-anagrammi.mjs",
    "ghigliottina:locale": "vite-node scripts/genera-ghigliottina.ts -- --local",
    "ghigliottina:build": "node scripts/build-ghigliottina.mjs",
    "paroliere:locale": "vite-node scripts/genera-paroliere.ts -- --local",
    "catena:locale": "vite-node scripts/genera-catena.ts -- --local",
    "catena:build": "node scripts/build-catena.mjs",
    "scarabocchi:build": "node scripts/build-scarabocchi.mjs",
    "nomi:lessico": "vite-node scripts/genera-lessico-nomi.ts",
    "dawg:build": "node scripts/build-dawg.mjs",
    "icone": "node scripts/genera-icone.mjs",
    "db:migrate:local": "wrangler d1 migrations apply game-hub-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply game-hub-db --remote",
    "cf:dev": "wrangler pages dev --proxy 5173 -- npm run dev",
    "dev:api": "wrangler pages dev --port 8788",
    "check:config": "node scripts/check-config.mjs"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260829.1",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "wrangler": "^4.127.1"
  },
  "engines": {
    "node": ">=20"
  }
}
